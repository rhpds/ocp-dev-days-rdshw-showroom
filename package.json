  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@antora/cli": "3.1",
    "@antora/site-generator": "3.1",
    "@sntke/antora-mermaid-extension": "0.0.13",
    "concurrently": "9.2.4",
    "http-server": "14.1.1",
    "nodemon": "^3.1.7"
  }
}
