{
  "name": "showroom-v2",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "antora site.yml",
    "serve": "http-server www -c-1 -p 8080 --cors",
    "watch": "nodemon --watch content --watch supplemental-ui --ext adoc,yml,js,css,hbs --exec 'antora --fetch local-site.yml'",
    "dev": "concurrently -n antora,server -c cyan,green \"npm run watch\" \"npm run serve\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
